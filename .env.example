# 环境变量配置文件示例
# 复制此文件为 .env 并修改相应的值

# MySQL 配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=parking_system

# 后端数据库配置
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=parking_system

# JWT 密钥（生产环境请务必修改）
JWT_SECRET=your-secret-key-change-in-production

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:3000/api
